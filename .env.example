PORT=3800
# This checkout's Shopify dev store (handle, without .myshopify.com): sandbox-shop-NN,
# NN the worktree index (main is 00). One store per checkout: two `shopify app dev`
# sessions on one store overwrite each other's preview.
SHOPIFY_DEV_STORE=sandbox-shop-00
# Only needed by the admin Durable Object explorer (/admin/shop-agent-objects).
CLOUDFLARE_WORKERS_API_TOKEN=
# Partner API client token with the Manage apps permission; reads each shop's plan.
SHOPIFY_PARTNER_API_TOKEN=
# Better Auth (magic-link login for members and admins).
BETTER_AUTH_URL=http://localhost:3800
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated. Stamps role='admin' on first sign-in; survives d1:reset.
ADMIN_EMAILS=you@example.com,e2e.admin@example.com
# Demo mode: magic links are cached in KV and rendered on /login instead of emailed.
DEMO_MODE=true
