# Copy to .env (untracked). Each checkout needs its own port.
WEBSITE_PORT=3900
# This checkout's Shopify stores, mw10013-<environment>-shop-NN with NN the worktree index (00 in
# the main checkout). One dev store per checkout: two `shopify app dev` sessions on one store
# overwrite each other's app URL. `vp run stores:check` verifies both stores exist.
SHOPIFY_DEV_STORE=mw10013-dev-shop-00
SHOPIFY_E2E_STORE=mw10013-e2e-shop-00

SHOPIFY_APP_HANDLE=baton-local
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_APP_ID=

# Only needed by the admin Durable Object explorer (/admin/shop-agent-objects).
CLOUDFLARE_WORKERS_API_TOKEN=

