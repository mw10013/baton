{
  "name": "baton",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mkdir -p logs && set -a && source .env && set +a && vite dev --port $PORT 2>&1 | tee logs/server.log",
    "dev:force": "mkdir -p logs && set -a && source .env && set +a && vite dev --port $PORT --force 2>&1 | tee logs/server.log",
    "app:dev": "shopify app dev --config shopify.app.toml",
    "app:deploy": "shopify app deploy --config shopify.app.toml",
    "app:deploy:staging": "shopify app deploy --config staging",
    "app:deploy:PRODUCTION": "shopify app deploy --config production",
    "app:open:staging": "open 'https://admin.shopify.com/store/sandbox-shop-01/apps/baton-staging/app'",
    "app:open:PRODUCTION": "open 'https://admin.shopify.com/store/sandbox-shop-01/apps/baton-live/app'",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=staging pnpm build",
    "build:PRODUCTION": "CLOUDFLARE_ENV=production pnpm build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:e2e": "pnpm exec playwright test --project=e2e --headed",
    "test:integration": "pnpm vitest --config test/integration/vitest.config.ts run",
    "test:browser": "pnpm vitest --config test/browser/vitest.config.ts run",
    "test:browser:headed": "VITEST_BROWSER_HEADLESS=false pnpm vitest --config test/browser/vitest.config.ts run",
    "deploy": "pnpm run build && wrangler deploy",
    "deploy:staging": "pnpm build:staging && wrangler deploy --env staging --secrets-file .env.staging",
    "deploy:PRODUCTION": "pnpm build:PRODUCTION && wrangler deploy --env production --secrets-file .env.production",
    "preview": "pnpm run build && vite preview",
    "cf-typegen": "wrangler types",
    "clean": "pnpm clean:node && pnpm clean:wrangler && pnpm clean:etc",
    "clean:node": "rm -rf node_modules",
    "clean:wrangler": "rm -rf .wrangler",
    "clean:etc": "rm -rf .tanstack build dist",
    "clean:playwright-cli": "find .playwright-cli -type f -mtime +1 -delete 2>/dev/null || true",
    "playwright-cli": "node node_modules/playwright-core/lib/tools/cli-client/cli.js",
    "typecheck": "pnpm run cf-typegen && tsc -b . test",
    "lint": "oxlint --format agent",
    "fmt": "oxfmt . '!refs/**' '!dist/**'",
    "fmt:check": "oxfmt --check . '!refs/**' '!dist/**'",
    "port": "source .env && echo $PORT",
    "graphql-codegen": "graphql-codegen",
    "d1:migrate:list": "wrangler d1 migrations list baton-d1-local --local",
    "d1:migrations": "wrangler d1 execute baton-d1-local --local --command \"select * from d1_migrations order by id\"",
    "d1:migrate:apply": "wrangler d1 migrations apply baton-d1-local --local",
    "d1:migrate:list:staging": "wrangler d1 migrations list baton-d1-staging --env staging --remote",
    "d1:migrations:staging": "wrangler d1 execute baton-d1-staging --env staging --remote --command \"select * from d1_migrations order by id\"",
    "d1:migrate:apply:staging": "wrangler d1 migrations apply baton-d1-staging --env staging --remote",
    "d1:migrate:list:PRODUCTION": "wrangler d1 migrations list baton-d1-production --env production --remote",
    "d1:migrations:PRODUCTION": "wrangler d1 execute baton-d1-production --env production --remote --command \"select * from d1_migrations order by id\"",
    "d1:migrate:apply:PRODUCTION": "wrangler d1 migrations apply baton-d1-production --env production --remote",
    "d1:reset": "node scripts/d1-reset.ts --env local",
    "d1:reset:staging": "node scripts/d1-reset.ts --env staging",
    "d1:reset:PRODUCTION": "node scripts/d1-reset.ts --env production",
    "refs": "node scripts/refs.ts",
    "refs:all": "node scripts/refs.ts fetch --all",
    "refs:check": "node scripts/refs.ts check",
    "tail": "mkdir -p logs && wrangler tail --format json 2>&1 | tee logs/tail.log | jq -r --unbuffered -f scripts/wrangler-tail-compact.jq | tee logs/tail-compact.log",
    "tail:staging": "mkdir -p logs && wrangler tail --env staging --format json 2>&1 | tee logs/staging.log | jq -r --unbuffered -f scripts/wrangler-tail-compact.jq | tee logs/staging-compact.log",
    "tail:PRODUCTION": "mkdir -p logs && wrangler tail --env production --format json 2>&1 | tee logs/production.log | jq -r --unbuffered -f scripts/wrangler-tail-compact.jq | tee logs/production-compact.log"
  },
  "dependencies": {
    "@effect/sql-d1": "4.0.0-rc.108",
    "@effect/sql-sqlite-do": "4.0.0-rc.108",
    "@shopify/app-bridge-react": "4.2.13",
    "@shopify/shopify-api": "14.0.1",
    "@tanstack/react-form": "1.33.3",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.19",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.36",
    "@tanstack/router-plugin": "1.168.24",
    "agents": "0.20.1",
    "better-auth": "1.7.2",
    "effect": "4.0.0-rc.108",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "vite-tsconfig-paths": "6.1.1"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "7.29.0",
    "@cloudflare/vite-plugin": "1.50.0",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@effect/platform-node": "4.0.0-rc.108",
    "@effect/vitest": "4.0.0-rc.108",
    "@graphql-codegen/cli": "6.3.1",
    "@graphql-codegen/typescript": "5.0.10",
    "@playwright/test": "1.62.1",
    "@shopify/api-codegen-preset": "2.0.1",
    "@shopify/app-bridge-types": "0.7.2",
    "@shopify/polaris-types": "1.0.7",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@tanstack/start-storage-context": "1.167.18",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/browser-playwright": "4.1.4",
    "graphql-config": "5.1.6",
    "jsonc-parser": "3.3.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright-core": "1.62.1",
    "typescript": "6.0.3",
    "vite": "7.3.0",
    "vitest": "4.1.4",
    "vitest-browser-react": "2.2.0",
    "wrangler": "4.118.0"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@10.17.1"
}
