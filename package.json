{
  "name": "baton",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:alchemy": "bash -c 'environment=$(node scripts/web.ts) && exec vp run \"web:$environment\"'",
    "web:dev": "bash -o pipefail -c 'stage=$(node scripts/stage.ts dev) && mkdir -p ./.logs/dev && env -u FORCE_COLOR NO_COLOR=1 alchemy dev --stage \"$stage\" 2>&1 | s6-log -b -l 65536 n20 s5242880 S104857600 T ./.logs/dev 1'",
    "web:e2e": "bash -c 'stage=$(node scripts/stage.ts e2e) && exec env -u FORCE_COLOR NO_COLOR=1 alchemy dev --stage \"$stage\"'",
    "app:dev": "bash -o pipefail -c 'set -a && source .env && set +a && BACKEND_PORT=\"${WEBSITE_PORT:?WEBSITE_PORT is not set in .env}\" exec shopify app dev --config shopify.app.toml --store \"${SHOPIFY_DEV_STORE:?SHOPIFY_DEV_STORE is not set in .env}\"'",
    "dev": "node --env-file=.env scripts/dev.ts start",
    "dev:stop": "node --env-file=.env scripts/dev.ts stop",
    "dev:status": "node --env-file=.env scripts/dev.ts status",
    "dev:logs": "node scripts/dev.ts logs",
    "browser": "node --env-file=.env scripts/browser.ts",
    "clean:playwright-cli": "find .playwright-cli -type f -mtime +1 -delete 2>/dev/null || true",
    "db:reset": "node --env-file=.env scripts/dev.ts db:reset",
    "e2e:start": "node --env-file=.env scripts/e2e.ts start",
    "e2e:stop": "node --env-file=.env scripts/e2e.ts stop",
    "e2e:status": "node --env-file=.env scripts/e2e.ts status",
    "e2e:restart": "node --env-file=.env scripts/e2e.ts restart",
    "e2e:logs": "node scripts/e2e.ts logs",
    "e2e:serve": "node --env-file=.env scripts/e2e-server.ts",
    "worktree:init": "node scripts/worktree.ts init",
    "stores:check": "node --env-file=.env scripts/stores.ts check",
    "fixture": "node --env-file=.env scripts/fixture.ts",
    "port": "node --env-file=.env -p \"process.env.WEBSITE_PORT ?? (console.error('WEBSITE_PORT is not set'), process.exit(1))\"",
    "test:e2e": "vp exec playwright test",
    "test:e2e:headed": "vp exec playwright test --headed",
    "test:e2e:billing": "bash -c 'E2E_BILLING=1 exec vp exec playwright test --project=billing --headed'",
    "e2e:auth": "node scripts/shopify-admin-auth.ts",
    "test:e2e:ui": "vp exec playwright test --ui",
    "help:screenshots": "node --env-file=.env scripts/help-screenshots.ts",
    "deploy:staging": "alchemy deploy --stage staging --yes",
    "cloud:reset": "node scripts/cloud-reset.ts",
    "stage-config": "alchemy deploy --config stacks/stage-config.ts",
    "refs": "node scripts/refs.ts",
    "refs:all": "node scripts/refs.ts fetch --all",
    "refs:check": "node scripts/refs.ts check"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.81",
    "@effect/atom-react": "4.0.1",
    "@effect/platform-node": "4.0.1",
    "@effect/sql-sqlite-do": "4.0.1",
    "@shopify/shopify-api": "15.0.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "alchemy": "2.0.0-beta.81",
    "better-auth": "1.7.7",
    "effect": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "scheduler": "0.27.0"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare-runtime": "2.0.0-beta.81",
    "@cloudflare/workers-types": "5.20261006.1",
    "@effect/sql-sqlite-node": "4.0.1",
    "@effect/vitest": "4.0.1",
    "@shopify/polaris-types": "2.0.0-rc.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "2.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1"
}
