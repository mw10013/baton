# The embedded app's admin URL: https://admin.shopify.com/store/<store>/apps/<handle>/app
# `<handle>` is `handle` in shopify.app.toml. Also the source of the shop domain
# the e2e seed endpoint writes to (`<store>.myshopify.com`), so it must name the
# store the app is actually installed on.
# SHOPIFY_PREVIEW_URL=https://admin.shopify.com/store/sandbox-shop-01/apps/baton-local/app
SHOPIFY_PREVIEW_URL=
