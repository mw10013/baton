{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Top-level name is used by Wrangler as the Cloudflare service grouping tag for all deployed envs.
  "name": "baton",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "vars": {
    "ENVIRONMENT": "local",
    // Fill in after `shopify app config link` and `shopify app info`.
    // CLOUDFLARE_ACCOUNT_ID is only read by the admin Durable Object explorer.
    "CLOUDFLARE_ACCOUNT_ID": "87997fc2724b0127effb8e4524989975",
    "SHOPIFY_PARTNER_ORG_ID": "2798461",
    "SHOPIFY_PARTNER_APP_ID": "417214922753",
    "SHOPIFY_APP_HANDLE": "baton-local",
    // App Pricing plans do not exist yet. While this is "false",
    // `SubscriptionPlan` grants every shop `Domain.DEFAULT_PLAN_HANDLE` without
    // calling the Partner API, so the `/app` gate and the WebSocket connect
    // check keep running in their real shape and always pass. Set to "true"
    // once the plans are created in Partners — nothing else changes.
    "BILLING_ENABLED": "false",
    "EMAIL_FROM": "noreply@mail.mw10013.com"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    // Workers traces (https://developers.cloudflare.com/workers/observability/traces/)
    // bill each span as an observability event at the same $0.60/M rate as log
    // events, and the automatic instrumentation emits a
    // `durable_object_storage_exec` span for every SQLite statement inside
    // ShopAgent — several times the cost of the log events for the same work.
    // Nothing consumes them: Effect spans (`Effect.fn`, `Effect.withLogSpan`)
    // decorate logs only and do not bridge into Cloudflare's tracing, so the
    // spans are pure platform instrumentation with no application detail.
    // Re-enable temporarily with `head_sampling_rate` ~0.05 for a performance
    // investigation, or briefly at 1 to read the
    // `cloudflare.durable_object.response.rows_written` span attribute — the
    // ground truth for billed rows per action.
    "traces": {
      "enabled": false
    }
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "baton-d1-local",
      "database_id": "baton-d1-local"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SHOP_AGENT",
        "class_name": "ShopAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ShopAgent"]
    }
  ],
  // Local id is arbitrary (miniflare keys storage off it). Deployed envs need a
  // real namespace via `wrangler kv namespace create`. Holds only demo-mode
  // magic-link URLs (`demo:magicLink:${email}`, TTL-bounded).
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "baton-kv-local"
    }
  ],
  // Email Sending binding (domain mail.mw10013.com onboarded at the account
  // level). `allowed_sender_addresses` pins the from-address so a bug cannot
  // send as an arbitrary @mw10013.com identity. Local dev simulates sends
  // (wrangler writes bodies to .wrangler/tmp/email/**); add `"remote": true`
  // for a one-off real-delivery check — real recipients get real mail.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@mail.mw10013.com"]
    }
  ],
  "ratelimits": [
    {
      // Account-wide ID; reuse shares counters across Workers and environments,
      // so pick unused ids before deploying anywhere real.
      "name": "ADMIN_LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      // Member magic-link sends. ADMIN_LOGIN_LIMITER retires with AdminAuth in
      // phase 2; this binding is the member-facing replacement.
      "name": "LOGIN_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Skeleton deploy targets. Wrangler does NOT inherit bindings or `vars` into
  // a named env (https://developers.cloudflare.com/workers/wrangler/environments/),
  // so every binding is re-declared here; `observability`, `compatibility_*`
  // and `main` are inherited. Placeholders (`database_id`, KV `id`,
  // `SHOPIFY_PARTNER_APP_ID`) are filled by `pnpm d1:reset:<env>` (writes the
  // real D1 id back into this block), `wrangler kv namespace create baton-kv
  // --env <env>`, and `shopify app info --config <env>`. The blocks exist now
  // so `ENVIRONMENT` narrows to "local" | "staging" | "production" in
  // `worker-configuration.d.ts` and `wrangler deploy --env staging` resolves;
  // nothing is deployed to either yet.
  "env": {
    "staging": {
      "name": "baton-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "CLOUDFLARE_ACCOUNT_ID": "87997fc2724b0127effb8e4524989975",
        "SHOPIFY_APP_URL": "https://baton-staging.mw10013.workers.dev",
        "SHOPIFY_PARTNER_ORG_ID": "2798461",
        "SHOPIFY_PARTNER_APP_ID": "",
        "SHOPIFY_APP_HANDLE": "baton-staging",
        "BILLING_ENABLED": "false",
        "EMAIL_FROM": "noreply@mail.mw10013.com"
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "baton-d1-staging",
          "database_id": "baton-d1-staging"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SHOP_AGENT",
            "class_name": "ShopAgent"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ShopAgent"]
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "baton-kv-staging"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@mail.mw10013.com"]
        }
      ],
      "ratelimits": [
        {
          // Account-wide ID; must differ from local and production.
          "name": "ADMIN_LOGIN_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "LOGIN_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    },
    "production": {
      "name": "baton",
      "routes": [
        {
          "pattern": "baton.mw10013.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "CLOUDFLARE_ACCOUNT_ID": "87997fc2724b0127effb8e4524989975",
        "SHOPIFY_APP_URL": "https://baton.mw10013.com",
        "SHOPIFY_PARTNER_ORG_ID": "2798461",
        "SHOPIFY_PARTNER_APP_ID": "",
        "SHOPIFY_APP_HANDLE": "baton-live",
        "BILLING_ENABLED": "false",
        "EMAIL_FROM": "noreply@mail.mw10013.com"
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "baton-d1-production",
          "database_id": "baton-d1-production"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "SHOP_AGENT",
            "class_name": "ShopAgent"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["ShopAgent"]
        }
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "baton-kv-production"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["noreply@mail.mw10013.com"]
        }
      ],
      "ratelimits": [
        {
          // Account-wide ID; must differ from local and staging.
          "name": "ADMIN_LOGIN_LIMITER",
          "namespace_id": "1005",
          "simple": { "limit": 5, "period": 60 }
        },
        {
          "name": "LOGIN_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 5, "period": 60 }
        }
      ]
    }
  }
}
